{
  "ldap": {
    "enabled": false,
    "protocol": "ldap",
    "host": "dc.example.com",
    "port": 389,
    "bind_dn_template": "EXAMPLE\\{username}",
    "base_dn": "OU=Users,DC=example,DC=com",
    "user_filter": "(sAMAccountName={username})",
    "tls": {
      "cacertfile": null,
      "verify": true
    },
    "groups": {
      "admin_enabled": false,
      "glossary_enabled": false,
      "admin_group": "DocuTranslate-Admins",
      "glossary_group": "DocuTranslate-Glossary",
      "group_base_dn": "OU=Groups,DC=example,DC=com"
    }
  },
  "default_user": {
    "username": "admin"
  },
  "session": {
    "cookie_name": "collabtrans_session",
    "max_age": 604800,
    "secret_key": "collabtrans-session-secret-key-2025-very-long-random-string-for-security"
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "db": 0,
    "password": null
  },
  "security": {
    "max_login_attempts": 5,
    "login_attempt_window": 300,
    "rate_limit_window": 300,
    "password_recovery": false
  },
  "messages": {
    "login_banner": "Welcome",
    "usage_message": "Drop file and translate"
  },
  "https": {
    "enabled": false,
    "cert_file": "/path/to/your/cert.crt",
    "key_file": "/path/to/your/key.key",
    "force_redirect": false
  }
  "server": {
    "root_path": "/trans"
  }
}
